<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Audit only DIRECT dependencies. The SQLite native lib (SQLitePCLRaw.lib.e_sqlite3)
         is pulled transitively by Microsoft.Data.Sqlite but is NOT shipped by this plugin
         (PrivateAssets=All + CopyLocalLockFileAssemblies=false) — at runtime the host's
         SQLite is used. Auditing transitive, host-provided libs only produces false-positive
         vulnerability warnings the plugin can't act on. Matches the jellyfin-12 branch. -->
    <NuGetAuditMode>direct</NuGetAuditMode>

    <!-- Versioning & Metadata -->
    <AssemblyVersion>5.7.12.0</AssemblyVersion>
    <FileVersion>5.7.12.0</FileVersion>
    <Version>5.7.12.0</Version>
    <Authors>ElieM, Peterdu1109</Authors>
    <Company>NotifySync</Company>
    <Product>NotifySync</Product>
    <Description>NotifySync transforme l'interface de Jellyfin en ajoutant une icône de notification (cloche) native. Il permet à vos utilisateurs de voir instantanément les derniers ajouts (Films, Séries, Musique) sans quitter leur page actuelle.</Description>
    <Copyright>Copyright © 2026 ElieM &amp; Peterdu1109</Copyright>
    
    <!-- Optimizations -->
    <TieredPGO>true</TieredPGO>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>jellyfin.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.0" PrivateAssets="All" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.0" PrivateAssets="All" />
    <PackageReference Include="Jellyfin.Data" Version="10.11.0" PrivateAssets="All" />

    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.17" PrivateAssets="All" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>
  
  <ItemGroup>
    <EmbeddedResource Include="client.js" />
    <EmbeddedResource Include="ConfigurationPage.html" />
  </ItemGroup>
</Project>