<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Audit only DIRECT dependencies. The SQLite native lib (SQLitePCLRaw.lib.e_sqlite3)
         is pulled transitively by Microsoft.Data.Sqlite but is NOT shipped by this plugin
         (PrivateAssets=All + CopyLocalLockFileAssemblies=false) — at runtime the host's
         SQLite is used. Auditing transitive, host-provided libs only produces false-positive
         vulnerability warnings the plugin can't act on. -->
    <NuGetAuditMode>direct</NuGetAuditMode>

    <!-- Versioning & Metadata -->
    <AssemblyVersion>5.8.0.1</AssemblyVersion>
    <FileVersion>5.8.0.1</FileVersion>
    <Version>5.8.0.1</Version>
    <Authors>ElieM, Peterdu1109</Authors>
    <Company>NotifySync</Company>
    <Product>NotifySync</Product>
    <Description>NotifySync transforme l'interface de Jellyfin en ajoutant une icône de notification (cloche) native. Il permet à vos utilisateurs de voir instantanément les derniers ajouts (Films, Séries, Musique) sans quitter leur page actuelle.</Description>
    <Copyright>Copyright © 2026 ElieM &amp; Peterdu1109</Copyright>
    
    <!-- Optimizations -->
    <TieredPGO>true</TieredPGO>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>jellyfin.ruleset</CodeAnalysisRuleSet>

    <!-- CA1873 is a .NET 10 analyzer flagging logging args evaluated even when the level is
         off. Our flagged args are cheap property reads, so the perf concern is negligible —
         suppress rather than guard ~40 call sites. -->
    <NoWarn>$(NoWarn);CA1873</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-rc3" PrivateAssets="All" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0-rc3" PrivateAssets="All" />
    <PackageReference Include="Jellyfin.Data" Version="12.0.0-rc3" PrivateAssets="All" />

    <!-- MUST match the Microsoft.Data.Sqlite version Jellyfin 12 ships (the plugin does NOT
         bundle it: PrivateAssets=All + CopyLocalLockFileAssemblies=false, so at runtime it
         binds to the host's copy, and .NET refuses a host version LOWER than the compiled
         reference — a too-high pin causes FileLoadException / "Malfunctioned"). 10.0.9 ran on
         12.0.0-rc3; RE-VERIFY against the exact version Jellyfin 12 stable bundles before
         publishing. The transitive SQLite-vuln warning is handled by NuGetAuditMode=direct. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" PrivateAssets="All" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>
  
  <ItemGroup>
    <EmbeddedResource Include="client.js" />
    <EmbeddedResource Include="ConfigurationPage.html" />
  </ItemGroup>
</Project>